default_platform(:ios)

# ---------------------------------------------------------------------------
# Algeciras CF Abonados — build + TestFlight upload con Fastlane
#
# Usa `match` en vez de cert/sigh para que el certificado de distribución
# y el provisioning profile se sincronicen entre runs de CI vía un repo
# git privado cifrado (crmhawkins/appalgeciras-fastlane-match).
#
# Env vars requeridas:
#   ASC_KEY_ID              → Key ID de App Store Connect API
#   ASC_ISSUER_ID           → Issuer ID (UUID)
#   ASC_API_KEY_PATH        → ruta absoluta al .p8
#   APPLE_TEAM_ID           → Team ID
#   APP_BUNDLE_ID           → es.algecirascf.abonos (default abajo)
#   MATCH_PASSWORD          → contraseña para cifrar el repo de match
#   MATCH_GIT_BASIC_AUTHORIZATION → base64("username:PAT") para clonar el repo
# ---------------------------------------------------------------------------

platform :ios do
  desc "Build the iOS app and submit it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_API_KEY_PATH"],
      in_house: false,
    )

    bundle_id = ENV["APP_BUNDLE_ID"] || "es.algecirascf.abonos"
    team_id   = ENV["APPLE_TEAM_ID"]
    scheme    = "AlgecirasCFAbonados"

    # Keychain dedicado en CI
    keychain_name = "algeciras_keychain"
    keychain_pwd  = "algecirastempkeychainpw"
    create_keychain(
      name: keychain_name,
      password: keychain_pwd,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    # Sync code signing — cert + profile vivos en un repo git cifrado.
    # El primer run con repo vacío crea cert + profile y los sube;
    # los siguientes los descargan y reusan (cero overhead de slots).
    match(
      type: "appstore",
      app_identifier: bundle_id,
      git_url: "https://github.com/crmhawkins/appalgeciras-fastlane-match",
      git_branch: "main",
      api_key: api_key,
      readonly: false,
      keychain_name: keychain_name,
      keychain_password: keychain_pwd,
      force: false,
      force_for_new_devices: false,
    )

    # Build number basado en último de TestFlight + 1
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id,
      initial_build_number: 0,
    ).to_i
    increment_build_number(
      xcodeproj: "ios/#{scheme}.xcodeproj",
      build_number: (latest_build + 1).to_s,
    )

    update_project_team(
      path: "ios/#{scheme}.xcodeproj",
      teamid: team_id,
    )

    profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"] ||
                   lane_context[SharedValues::SIGH_NAME] ||
                   "match AppStore #{bundle_id}"

    # Patch fmt header: Xcode 26 / clang 17 introdujeron strict consteval
    # checks que rompen la librería `fmt` que viene con React Native 0.81.5.
    # Reemplazamos tanto las macros `FMT_CONSTEVAL*` como la palabra clave
    # `consteval` directa por `constexpr` en los headers que se descargan
    # vía CocoaPods. Se ejecuta cada build (idempotente).
    sh "find ../ios/Pods/fmt -type f \\( -name '*.h' -o -name '*.cc' \\) -exec sed -i.bak -e 's/FMT_CONSTEVAL20/FMT_CONSTEXPR20/g' -e 's/FMT_CONSTEVAL/FMT_CONSTEXPR/g' -e 's/[[:<:]]consteval[[:>:]]/constexpr/g' {} +" rescue nil

    gym(
      workspace: "ios/#{scheme}.xcworkspace",
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "ios/build",
      output_name: "#{scheme}.ipa",
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        provisioningProfiles: { bundle_id => profile_name },
      },
      # GCC_TREAT_WARNINGS_AS_ERRORS=NO: Xcode 26 / clang 17 endurecieron varios
      # warnings (sobre todo en `fmt` y `glog` de React Native) que rompen el
      # archive con C++20 strict consteval. Desactivarlo evita que warnings
      # válidas (no errores reales) aborten el build.
      xcargs: %Q(DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY="Apple Distribution" PROVISIONING_PROFILE_SPECIFIER="#{profile_name}" GCC_TREAT_WARNINGS_AS_ERRORS=NO -allowProvisioningUpdates),
    )

    pilot(
      api_key: api_key,
      ipa: "ios/build/#{scheme}.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      apple_id: nil,
      app_identifier: bundle_id,
    )

    UI.success("✅ Algeciras CF Abonados subido a TestFlight. Procesando ~5-15 min.")
  end
end
