default_platform(:ios)

# ---------------------------------------------------------------------------
# Algeciras CF Abonados — build + TestFlight upload + App Store submit
#
# Usa `match` para sincronizar cert + provisioning profile entre runs de CI
# vía un repo git privado cifrado (crmhawkins/appalgeciras-fastlane-match).
#
# Env vars requeridas (todas las lanes):
#   ASC_KEY_ID              → Key ID de App Store Connect API
#   ASC_ISSUER_ID           → Issuer ID (UUID)
#   ASC_API_KEY_PATH        → ruta absoluta al .p8
#   APPLE_TEAM_ID           → Team ID
#   APP_BUNDLE_ID           → es.algecirascf.abonos (default abajo)
#   MATCH_PASSWORD          → contraseña para cifrar el repo de match
#   MATCH_GIT_BASIC_AUTHORIZATION → base64("username:PAT") para clonar
# ---------------------------------------------------------------------------

platform :ios do

  # Helper común para todas las lanes que tocan signing.
  def setup_signing
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_API_KEY_PATH"],
      in_house: false,
    )

    bundle_id = ENV["APP_BUNDLE_ID"] || "es.algecirascf.abonos"
    team_id   = ENV["APPLE_TEAM_ID"]

    # Scheme se calcula desde app.json (expo prebuild lo genera quitando
    # los espacios del campo `expo.name`). Antes estaba hardcoded
    # "AlgecirasCFAbonados" y rompió cuando se renombró a "Algeciras CF"
    # en el commit del 02/06 — ahora siempre coincide con el .xcodeproj real.
    require "json"
    app_json = JSON.parse(File.read(File.expand_path("../app.json", __dir__)))
    scheme   = (app_json.dig("expo", "name") || "AlgecirasCF").gsub(/\s+/, "")
    UI.message("📦 Scheme detectado desde app.json: #{scheme}")

    keychain_name = "algeciras_keychain"
    keychain_pwd  = "algecirastempkeychainpw"
    create_keychain(
      name: keychain_name,
      password: keychain_pwd,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    match(
      type: "appstore",
      app_identifier: bundle_id,
      git_url: "https://github.com/crmhawkins/appalgeciras-fastlane-match",
      git_branch: "main",
      api_key: api_key,
      readonly: false,
      keychain_name: keychain_name,
      keychain_password: keychain_pwd,
      force: false,
      force_for_new_devices: false,
    )

    profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"] ||
                   lane_context[SharedValues::SIGH_NAME] ||
                   "match AppStore #{bundle_id}"

    { api_key: api_key, bundle_id: bundle_id, team_id: team_id, scheme: scheme, profile_name: profile_name }
  end

  desc "Build the iOS app and submit it to TestFlight"
  lane :beta do
    cfg = setup_signing

    latest_build = latest_testflight_build_number(
      api_key: cfg[:api_key],
      app_identifier: cfg[:bundle_id],
      initial_build_number: 0,
    ).to_i
    increment_build_number(
      xcodeproj: "ios/#{cfg[:scheme]}.xcodeproj",
      build_number: (latest_build + 1).to_s,
    )
    update_project_team(
      path: "ios/#{cfg[:scheme]}.xcodeproj",
      teamid: cfg[:team_id],
    )

    # Patch fmt header (Xcode 26 / clang 17 strict consteval).
    sh "find ../ios/Pods/fmt -type f \\( -name '*.h' -o -name '*.cc' \\) -exec sed -i.bak -e 's/FMT_CONSTEVAL20/FMT_CONSTEXPR20/g' -e 's/FMT_CONSTEVAL/FMT_CONSTEXPR/g' -e 's/[[:<:]]consteval[[:>:]]/constexpr/g' {} +" rescue nil

    gym(
      workspace: "ios/#{cfg[:scheme]}.xcworkspace",
      scheme: cfg[:scheme],
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "ios/build",
      output_name: "#{cfg[:scheme]}.ipa",
      export_options: {
        method: "app-store",
        teamID: cfg[:team_id],
        signingStyle: "manual",
        provisioningProfiles: { cfg[:bundle_id] => cfg[:profile_name] },
      },
      xcargs: %Q(DEVELOPMENT_TEAM=#{cfg[:team_id]} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY="Apple Distribution" PROVISIONING_PROFILE_SPECIFIER="#{cfg[:profile_name]}" GCC_TREAT_WARNINGS_AS_ERRORS=NO -allowProvisioningUpdates),
    )

    pilot(
      api_key: cfg[:api_key],
      ipa: "ios/build/#{cfg[:scheme]}.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      apple_id: nil,
      app_identifier: cfg[:bundle_id],
    )

    UI.success("✅ Algeciras CF Abonados subido a TestFlight. Procesando ~5-15 min.")
  end

  desc "Crear/actualizar App Store version 1.0.7 + asociar build TF (sin submit aún)"
  lane :release do
    cfg = setup_signing

    app_version = ENV["APP_VERSION"] || get_version_number(
      xcodeproj: "ios/#{cfg[:scheme]}.xcodeproj",
      target: cfg[:scheme],
    )

    UI.message("📦 Uploading metadata para version #{app_version}...")

    # PASO 1: sólo subir metadata (sin submit_for_review).
    # Esto crea la entrada de App Store version si no existe y sube
    # description/subtitle/keywords/URLs/etc.
    #
    # Si la app NUNCA tuvo una versión en App Store (sólo TestFlight),
    # Spaceship a veces no consigue encontrar la versión a la primera
    # — por eso hacemos esto en 2 pasos en lugar de 1.
    deliver(
      api_key: cfg[:api_key],
      app_identifier: cfg[:bundle_id],
      app_version: app_version,

      skip_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: false,

      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
    )

    UI.success("✅ Metadata v#{app_version} subida. Próximo paso: lane `ios submit` para asociar build + submit for review.")
  end

  desc "Configurar pricing=free + age rating todo None vía ASC API (one-time setup)"
  lane :setup_appstore do
    cfg = setup_signing
    require "spaceship"

    Spaceship::ConnectAPI.token = cfg[:api_key]
    app = Spaceship::ConnectAPI::App.find(cfg[:bundle_id])
    if app.nil?
      UI.user_error!("App #{cfg[:bundle_id]} no encontrada en App Store Connect")
    end

    UI.message("📋 Configurando age rating (todo None/No)...")

    # Age Rating Declaration: todos los campos a None/No.
    # Apple cambió 2024 a este esquema granular con ~25 campos.
    age_rating_attrs = {
      alcoholTobaccoOrDrugUseOrReferences: "NONE",
      contests: "NONE",
      gamblingSimulated: "NONE",
      medicalOrTreatmentInformation: "NONE",
      profanityOrCrudeHumor: "NONE",
      sexualContentGraphicAndNudity: "NONE",
      sexualContentOrNudity: "NONE",
      horrorOrFearThemes: "NONE",
      matureOrSuggestiveThemes: "NONE",
      unrestrictedWebAccess: false,
      gambling: false,
      gamblingAndContests: false,
      violenceCartoonOrFantasy: "NONE",
      violenceRealistic: "NONE",
      violenceRealisticProlongedGraphicOrSadistic: "NONE",
      gunsOrOtherWeapons: "NONE",
      healthOrWellnessTopics: "NONE",
      ageAssurance: "NOT_USED",
      messagingAndChat: "NOT_USED",
      parentalControls: "NOT_PRESENT",
      userGeneratedContent: "NONE",
      socialNetworkingOrCommunication: "NONE",
      advertising: "NONE",
      kidsAgeBand: nil,
      seventeenPlus: false,
    }

    begin
      # Hay 2 sitios donde Apple guarda la declaración:
      #   - AppInfo.ageRatingDeclaration (preferido)
      #   - App.ageRatingDeclaration (legacy)
      app_info = Spaceship::ConnectAPI::AppInfo.get_app_infos(app_id: app.id).first
      decl = app_info&.fetch_age_rating_declaration
      if decl
        Spaceship::ConnectAPI.patch_age_rating_declaration(
          age_rating_declaration_id: decl.id,
          attributes: age_rating_attrs,
        )
        UI.success("✅ Age rating actualizado en AppInfo declaration #{decl.id}")
      else
        UI.important("⚠️  No se encontró age rating declaration — Apple la crea automáticamente al submitear")
      end
    rescue => e
      UI.error("Age rating: #{e.message}")
    end

    UI.message("💰 Configurando pricing → Free (price tier 0)...")
    begin
      # Tier 0 = Free en todos los territorios.
      # API endpoint: POST /v1/appPriceSchedules
      Spaceship::ConnectAPI.post(
        url: "appPriceSchedules",
        body: {
          data: {
            type: "appPriceSchedules",
            relationships: {
              app: { data: { type: "apps", id: app.id } },
              manualPrices: {
                data: [{ type: "appPrices", id: "${new-price}" }]
              },
            }
          },
          included: [{
            type: "appPrices",
            id: "${new-price}",
            attributes: { startDate: nil },
            relationships: {
              appPricePoint: { data: { type: "appPricePoints", id: "eyJzIjoiNjc3MzY1MjQ3NyIsInQiOiJVU0EiLCJwIjoiMCJ9" } },  # tier 0 USA Free
            }
          }]
        }
      )
      UI.success("✅ Pricing → Free")
    rescue => e
      UI.important("Pricing: #{e.message} (probablemente ya esté seteado)")
    end

    UI.success("✅ Setup App Store completado. Sólo faltan screenshots para submit.")
  end

  desc "Asociar último build TestFlight a App Store version + submit for review"
  lane :submit do
    cfg = setup_signing

    # Versión: priorizar env APP_VERSION; si no hay xcodeproj generado (este lane
    # corre sin gym), leerla de app.json para evitar app_version vacío que rompe
    # el filter de App Store API.
    app_version = ENV["APP_VERSION"]
    if app_version.nil? || app_version.strip.empty?
      require "json"
      app_json = JSON.parse(File.read("../app.json"))
      app_version = app_json.dig("expo", "version") || "1.0.7"
    end

    # Build a asociar: el último de TestFlight para esta versión.
    latest_build = latest_testflight_build_number(
      api_key: cfg[:api_key],
      app_identifier: cfg[:bundle_id],
      version: app_version,
      initial_build_number: 1,
    ).to_s

    UI.message("🚀 Submitting v#{app_version} build #{latest_build} a App Store Review...")

    # PASO 2: sólo submit. La versión ya existe (creada por lane :release),
    # ahora deliver sólo asocia build + envía a review.
    deliver(
      api_key: cfg[:api_key],
      app_identifier: cfg[:bundle_id],
      app_version: app_version,
      build_number: latest_build,  # asocia explícitamente este build

      skip_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      skip_metadata: true,

      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,

      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        export_compliance_is_exempt: true,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false,
      },

      app_review_information: {
        first_name: "Ivan",
        last_name:  "Garcia",
        phone_number: "+34 600 000 000",
        email_address: "ivan@hawkins.es",
        demo_user: "",
        demo_password: "",
        notes: "App de gestion de abonos del Algeciras CF. Login opcional. La compra real esta en pasarela Stripe (modo live) — para review, no es necesario completar compra.",
      },
    )

    UI.success("✅ Version #{app_version} enviada a App Store Review. Apple tarda 24-48h en revisar.")
  end
end

# ---------------------------------------------------------------------------
# Android — build AAB firmado + upload a Google Play internal track
# ---------------------------------------------------------------------------
#
# Env vars requeridas:
#   ANDROID_KEYSTORE_BASE64      → keystore .jks codificado base64
#   ANDROID_KEYSTORE_PASSWORD    → contraseña del keystore
#   ANDROID_KEY_ALIAS            → alias de la clave dentro del keystore
#   ANDROID_KEY_PASSWORD         → contraseña de la clave
#   GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_B64 → service account JSON en base64
#
# El primer upload requiere que la app exista en Google Play Console (manual).
platform :android do
  desc "Build AAB firmado y subir a Google Play (internal track)"
  lane :internal do
    package_name = ENV["APP_PACKAGE_NAME"] || "com.algecirascf.app"

    # Decodificar keystore desde env (base64 → fichero temporal).
    keystore_path = File.expand_path("../android/app/algeciras-release.keystore")
    require "base64"
    File.write(keystore_path, Base64.decode64(ENV["ANDROID_KEYSTORE_BASE64"]))

    # Pasar las contraseñas al Gradle build vía system properties (no se
    # escriben a disco para no leakearlas).
    gradle_props = [
      "-PALGECIRAS_RELEASE_STORE_FILE=#{keystore_path}",
      "-PALGECIRAS_RELEASE_KEY_ALIAS=#{ENV["ANDROID_KEY_ALIAS"]}",
      "-PALGECIRAS_RELEASE_STORE_PASSWORD=#{ENV["ANDROID_KEYSTORE_PASSWORD"]}",
      "-PALGECIRAS_RELEASE_KEY_PASSWORD=#{ENV["ANDROID_KEY_PASSWORD"]}",
    ].join(" ")

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/",
      properties: {
        "ALGECIRAS_RELEASE_STORE_FILE"     => keystore_path,
        "ALGECIRAS_RELEASE_KEY_ALIAS"      => ENV["ANDROID_KEY_ALIAS"],
        "ALGECIRAS_RELEASE_STORE_PASSWORD" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "ALGECIRAS_RELEASE_KEY_PASSWORD"   => ENV["ANDROID_KEY_PASSWORD"],
      }
    )

    aab_path = "android/app/build/outputs/bundle/release/app-release.aab"

    # Service account JSON: vuelca a fichero temporal y supply lo lee.
    sa_path = File.expand_path("../play-service-account.json")
    File.write(sa_path, Base64.decode64(ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_B64"]))

    supply(
      package_name: package_name,
      track: "internal",                 # internal | alpha | beta | production
      aab: aab_path,
      json_key: sa_path,
      release_status: "draft",            # publicar manualmente desde Play Console la 1ª vez
      skip_upload_metadata: true,        # se sube manualmente la 1ª release
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )

    UI.success("✅ AAB subido a Google Play Console (track: internal, status: draft). Promoción a producción manual.")
  end

  desc "Build AAB firmado SIN subir a Play (artifact-only). Para primer release manual."
  lane :build_only do
    # Idéntico a :internal pero sin supply al final.
    # Útil cuando todavía no hay Service Account vinculado en Play Console,
    # o cuando los cuestionarios (Data Safety, Content Rating) están a medias
    # y supply rechaza porque la app no está en estado "Ready to publish".
    keystore_path = File.expand_path("../android/app/algeciras-release.keystore")
    require "base64"
    File.write(keystore_path, Base64.decode64(ENV["ANDROID_KEYSTORE_BASE64"]))

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/",
      properties: {
        "ALGECIRAS_RELEASE_STORE_FILE"     => keystore_path,
        "ALGECIRAS_RELEASE_KEY_ALIAS"      => ENV["ANDROID_KEY_ALIAS"],
        "ALGECIRAS_RELEASE_STORE_PASSWORD" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "ALGECIRAS_RELEASE_KEY_PASSWORD"   => ENV["ANDROID_KEY_PASSWORD"],
      }
    )

    aab_path = "android/app/build/outputs/bundle/release/app-release.aab"
    UI.success("✅ AAB compilado: #{aab_path} — descárgalo desde el artifact del workflow y súbelo a Play Console.")
  end
end
