default_platform(:ios)

# ---------------------------------------------------------------------------
# Algeciras CF Abonados — build + TestFlight upload con Fastlane
#
# Variables de entorno requeridas (pasadas desde GitHub Actions):
#   ASC_KEY_ID            → Key ID de App Store Connect API
#   ASC_ISSUER_ID         → Issuer ID (UUID) de App Store Connect API
#   ASC_API_KEY_PATH      → ruta absoluta al archivo .p8
#   APPLE_TEAM_ID         → Team ID de la cuenta de Apple Developer
#   APP_BUNDLE_ID         → es.algecirascf.abonos (opcional, default abajo)
#
# El xcodeproj se genera con `expo prebuild --platform ios` y su nombre
# se deriva de `name` en app.json. Para "Algeciras CF Abonados" Expo
# produce `AlgecirasCFAbonados.xcodeproj`.
# ---------------------------------------------------------------------------

platform :ios do
  desc "Build the iOS app and submit it to TestFlight"
  lane :beta do
    # Autenticación contra App Store Connect (sin 2FA)
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_API_KEY_PATH"],
      in_house: false,
    )

    bundle_id = ENV["APP_BUNDLE_ID"] || "es.algecirascf.abonos"
    team_id   = ENV["APPLE_TEAM_ID"]
    scheme    = "AlgecirasCFAbonados"

    # Keychain dedicado para que codesign pueda correr desatendido
    keychain_name = "algeciras_keychain"
    keychain_pwd  = "algecirastempkeychainpw"
    create_keychain(
      name: keychain_name,
      password: keychain_pwd,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    # Distribution cert (lo crea o reutiliza vía API key)
    cert(
      api_key: api_key,
      development: false,
      keychain_path: "#{ENV['HOME']}/Library/Keychains/#{keychain_name}-db",
      keychain_password: keychain_pwd,
    )

    # Provisioning profile App Store
    sigh(
      api_key: api_key,
      app_identifier: bundle_id,
      force: true,
    )

    # Build number basado en último de TestFlight + 1
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id,
      initial_build_number: 0,
    ).to_i
    increment_build_number(
      xcodeproj: "ios/#{scheme}.xcodeproj",
      build_number: (latest_build + 1).to_s,
    )

    # Inyectar Team ID en project (manual signing)
    update_project_team(
      path: "ios/#{scheme}.xcodeproj",
      teamid: team_id,
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] || "iOS Team Provisioning Profile: #{bundle_id}"

    # Construir el .ipa
    gym(
      workspace: "ios/#{scheme}.xcworkspace",
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "ios/build",
      output_name: "#{scheme}.ipa",
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "manual",
        provisioningProfiles: { bundle_id => profile_name },
      },
      xcargs: %Q(DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY="Apple Distribution" PROVISIONING_PROFILE_SPECIFIER="#{profile_name}" -allowProvisioningUpdates),
    )

    # Subir a TestFlight (sin esperar processing)
    pilot(
      api_key: api_key,
      ipa: "ios/build/#{scheme}.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      apple_id: nil,
      app_identifier: bundle_id,
    )

    UI.success("✅ Algeciras CF Abonados subido a TestFlight. Procesando ~5-15 min.")
  end
end
