{
  "expo": {
    "name": "Algeciras CF Abonos",
    "slug": "algeciras-cf-abonos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/algeciras_shield.png",
    "scheme": "algecirascf",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/algeciras_shield.png",
      "resizeMode": "contain",
      "backgroundColor": "#C8102E"
    },
    "ios": {
      "bundleIdentifier": "es.algecirascf.abonos",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/algeciras_shield.png",
        "backgroundColor": "#C8102E"
      },
      "package": "es.algecirascf.abonos",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "0516104d-6016-4639-86b5-ace224362fcf"
      }
    },
    "owner": "dani.mefle"
  }
}
